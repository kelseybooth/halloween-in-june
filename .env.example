# Copy this file to .env and fill in real values. Never commit .env.

# Required: bot token from the Discord Developer Portal.
DISCORD_TOKEN=your_bot_token_here

# Optional: PostgreSQL connection string. Railway sets this automatically.
# Leave empty locally to use a SQLite file (catbot.db) with no setup.
DATABASE_URL=

# Optional: your test server's ID. Set it locally so slash commands appear
# instantly instead of taking up to an hour. Leave empty in production.
GUILD_ID=
