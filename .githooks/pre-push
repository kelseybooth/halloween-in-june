#!/bin/sh
# Check the content files before anything leaves this machine.
#
# **The test suite does not run here any more.** A ruleset on the default
# branch requires the `pytest` check from GitHub Actions, which runs the same
# suite against the pushed commit rather than against this working tree - so
# running it here was both redundant and the less accurate of the two.
#
# It was also costly in a way that bit: at twenty to thirty-five minutes a
# push, a branch merged and deleted inside that window leaves the push with
# nowhere to land and the commit is dropped without anybody noticing. That
# happened on 25 October.
#
# What is left is the one check CI is too slow to be useful for. A writer
# editing a TSV through GitHub's web editor cannot insert a tab, and one
# mangled cell stops the whole content set loading - worth a second here
# rather than ten minutes of CI and a branch that looks broken.
#
# Enable it once per clone:
#     git config core.hooksPath .githooks
#
# Skip it for a single push (a docs-only change, or a deliberately broken
# work-in-progress branch):
#     git push --no-verify

set -e

# Prefer the project virtualenv, since that is where the dependencies are
# installed; fall back to whatever python is on PATH.
if [ -x ".venv/Scripts/python.exe" ]; then
    PYTHON=".venv/Scripts/python.exe"      # Windows
elif [ -x ".venv/bin/python" ]; then
    PYTHON=".venv/bin/python"              # macOS and Linux
elif command -v python3 >/dev/null 2>&1; then
    PYTHON="python3"
else
    PYTHON="python"
fi

# `load_content.py` imports the database layer at module scope, so the check
# needs the project's dependencies even though it writes nothing.
if ! "$PYTHON" -c "import database" >/dev/null 2>&1; then
    echo "pre-push: the project dependencies are not installed for $PYTHON."
    echo "          Run: $PYTHON -m pip install -r requirements-dev.txt"
    echo "          Or skip this check once with: git push --no-verify"
    exit 1
fi

echo "pre-push: checking the content files..."
if ! "$PYTHON" load_content.py --check; then
    echo
    echo "pre-push: the content files did not load - push aborted."
    echo "          Fix them, or push anyway with: git push --no-verify"
    exit 1
fi

# The two emoji TSVs are built from the writers' catalogue, so a hand-edit
# to either one survives until the next export and then vanishes. This is
# the only moment anybody finds out, because the stale file still loads.
echo "pre-push: checking the generated emoji files..."
if ! "$PYTHON" generate_emoji_files.py --check; then
    echo
    echo "pre-push: the emoji files do not match the catalogue - push aborted."
    echo "          Regenerate them, or push anyway with: git push --no-verify"
    exit 1
fi

echo "pre-push: content is valid. The suite itself runs in CI."
